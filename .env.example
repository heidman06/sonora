# Sonora configuration
SONORA_PORT=3011
SONORA_HOST=127.0.0.1
SONORA_DATA=./data
SONORA_COOKIES=./data/yt-cookies.txt
YTDLP_PATH=/usr/bin/yt-dlp
FFMPEG_PATH=ffmpeg
SONORA_NODE_BIN=node
SONORA_EJS=ejs:github
SONORA_CACHE_MAX_BYTES=2147483648
# Optional: Piped instance used for search and related tracks
PIPED_URL=http://127.0.0.1:8081
